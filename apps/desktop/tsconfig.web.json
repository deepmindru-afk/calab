{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    // "node" only for *.test.ts (process, Buffer, node:fs): vitest <5 pulled @types/node into the
    // program transitively, vitest 5 does not. Renderer sources stay Node-free by review (ADR: no Node in renderer).
    "types": [
      "vite/client",
      "node"
    ],
    "jsx": "react-jsx",
    "noEmit": true,
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "src/renderer/**/*",
    "src/shared/**/*",
    "src/preload/api.d.ts"
  ],
  "exclude": [
    "src/renderer/lib/media/worklets/**/*"
  ]
}
